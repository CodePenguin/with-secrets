<Project Sdk="Microsoft.NET.Sdk">
    <!-- A plain console runner: no test framework package. Run it with `dotnet run`. It opens real windows for a moment. -->
    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
        <UseWindowsForms>true</UseWindowsForms>
        <RootNamespace>WithSecrets.Tests</RootNamespace>
    </PropertyGroup>
    <ItemGroup>
        <ProjectReference Include="..\..\src\WithSecrets.Core\WithSecrets.Core.csproj"/>
        <ProjectReference Include="..\..\src\WithSecrets.Windows\WithSecrets.Windows.csproj"/>
    </ItemGroup>
</Project>
