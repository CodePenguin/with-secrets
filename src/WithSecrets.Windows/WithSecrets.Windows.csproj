<Project Sdk="Microsoft.NET.Sdk">
    <!-- The Windows-only parts: the approval window (WinForms) and the Windows Hello prompt (WinRT). Both run inside the exe. -->
    <PropertyGroup>
        <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
        <UseWindowsForms>true</UseWindowsForms>
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
        <RootNamespace>WithSecrets</RootNamespace>
    </PropertyGroup>

    <ItemGroup>
        <ProjectReference Include="..\WithSecrets.Core\WithSecrets.Core.csproj"/>
        <InternalsVisibleTo Include="WithSecrets.Tests"/>
    </ItemGroup>
</Project>
