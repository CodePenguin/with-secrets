<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <RootNamespace>WithSecrets</RootNamespace>
    </PropertyGroup>
    <ItemGroup>
        <InternalsVisibleTo Include="WithSecrets.Tests" />
        <InternalsVisibleTo Include="WithSecrets.E2E" />
    </ItemGroup>
    <ItemGroup>
        <!-- Kestrel, for the one-shot approval page. -->
        <FrameworkReference Include="Microsoft.AspNetCore.App" />
    </ItemGroup>
    <ItemGroup>
      <PackageReference Include="System.CommandLine" Version="2.0.0" />
      <!-- state.db: passkeys, saved approvals, audit. The bundle carries its own native SQLite build (e_sqlite3). -->
      <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.14" />
      <PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" Version="2.1.14" />
      <!-- The secret values' crypto: the same "encrypted:" ECIES format, key pair and decrypt as Dotenvx. -->
      <PackageReference Include="Dotenvx.Primitives" Version="3.3.1" />
      <!-- Diagnostics: Debug events to the terminal and a rolling log file only with the debug option; warnings and errors always go to the file. Names and counts only. -->
      <PackageReference Include="Serilog" Version="4.3.0" />
      <PackageReference Include="Serilog.Sinks.File" Version="7.0.0" />
    </ItemGroup>

    <!--
        The administration web application (src/WithSecrets.Admin.Web: React, TypeScript, Vite) is built to its dist folder and EMBEDDED in this assembly as admin-web/... resources, so the program serves it
        from memory: no loose frontend file, no Node at run time, no download. How the frontend gets built:
          - A plain `dotnet build` (dev build) builds it when Node.js is on the PATH and the sources changed since the last build (npm ci only when package-lock.json changed). Without Node it uses an existing
            dist folder, or embeds nothing (the service then answers /admin with a JSON 404 that says so) and prints a message (not a warning), so the build still works and stays at 0 warnings.
          - `dotnet publish -p:AdminWebRequired=true` (the release; scripts/publish-win-x64.ps1 does it) FAILS with a clear error when Node is missing or the frontend build fails, so a release never lacks the application.
          - -p:BuildAdminWeb=false skips all of it (backend-only work).
        The frontend is built with this project's Version (WS_VERSION), the same version the backend reports at /api/v1/status.
    -->
    <PropertyGroup>
        <BuildAdminWeb Condition="'$(BuildAdminWeb)' == ''">true</BuildAdminWeb>
        <AdminWebRequired Condition="'$(AdminWebRequired)' == ''">false</AdminWebRequired>
        <AdminWebDir>$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)..\WithSecrets.Admin.Web\'))</AdminWebDir>
        <AdminWebDist>$(AdminWebDir)dist\</AdminWebDist>
    </PropertyGroup>
    <ItemGroup>
        <AdminWebSource Include="$(AdminWebDir)src\**\*;$(AdminWebDir)scripts\**\*;$(AdminWebDir)index.html;$(AdminWebDir)package.json;$(AdminWebDir)package-lock.json;$(AdminWebDir)vite.config.ts;$(AdminWebDir)tsconfig.json;$(AdminWebDir)eslint.config.js;$(MSBuildThisFileDirectory)..\..\docs\api\openapi.json;$(MSBuildThisFileDirectory)..\..\Directory.Build.props" />
    </ItemGroup>

    <Target Name="AdminWebCheckNode" Condition="'$(BuildAdminWeb)' == 'true'">
        <Exec Command="node --version" ContinueOnError="true" IgnoreExitCode="true" StandardOutputImportance="low" StandardErrorImportance="low">
            <Output TaskParameter="ExitCode" PropertyName="_AdminWebNodeExit" />
        </Exec>
        <PropertyGroup>
            <_AdminWebHasNode Condition="'$(_AdminWebNodeExit)' == '0'">true</_AdminWebHasNode>
            <_AdminWebHasNode Condition="'$(_AdminWebNodeExit)' != '0'">false</_AdminWebHasNode>
        </PropertyGroup>
        <Error Condition="'$(_AdminWebHasNode)' != 'true' And '$(AdminWebRequired)' == 'true'" Text="Node.js (22 or newer) is required to build the administration web application, and it was not found on the PATH. Install Node.js, or build without -p:AdminWebRequired=true for a development build that does not embed the application." />
        <Message Condition="'$(_AdminWebHasNode)' != 'true' And !Exists('$(AdminWebDist)index.html')" Importance="high" Text="with-secrets: Node.js was not found, so the administration web application is NOT embedded in this build (/admin answers a JSON 404). Install Node.js 22 or newer and build again." />
    </Target>

    <Target Name="AdminWebRestore" DependsOnTargets="AdminWebCheckNode" Condition="'$(BuildAdminWeb)' == 'true'" Inputs="$(AdminWebDir)package.json;$(AdminWebDir)package-lock.json" Outputs="$(AdminWebDir)node_modules\.package-lock.json">
        <Message Condition="'$(_AdminWebHasNode)' == 'true'" Importance="high" Text="with-secrets: installing the frontend packages (npm ci)." />
        <Exec Condition="'$(_AdminWebHasNode)' == 'true'" Command="npm ci --no-audit --no-fund" WorkingDirectory="$(AdminWebDir)" />
    </Target>

    <Target Name="AdminWebBuild" DependsOnTargets="AdminWebRestore" Condition="'$(BuildAdminWeb)' == 'true'" Inputs="@(AdminWebSource)" Outputs="$(AdminWebDist)version.json">
        <Message Condition="'$(_AdminWebHasNode)' == 'true'" Importance="high" Text="with-secrets: building the administration web application (npm run build, version $(Version))." />
        <Exec Condition="'$(_AdminWebHasNode)' == 'true'" Command="npm run build" WorkingDirectory="$(AdminWebDir)" EnvironmentVariables="WS_VERSION=$(Version)" />
    </Target>

    <Target Name="AdminWebEmbed" BeforeTargets="AssignTargetPaths" DependsOnTargets="AdminWebBuild" Condition="'$(BuildAdminWeb)' == 'true'">
        <Error Condition="'$(AdminWebRequired)' == 'true' And !Exists('$(AdminWebDist)index.html')" Text="The administration web application was not built ($(AdminWebDist)index.html is missing), and this build requires it." />
        <ItemGroup>
            <_AdminWebFile Include="$(AdminWebDist)**\*" />
            <EmbeddedResource Include="@(_AdminWebFile)" LogicalName="admin-web/$([System.String]::Copy('%(_AdminWebFile.RecursiveDir)%(_AdminWebFile.Filename)%(_AdminWebFile.Extension)').Replace('\', '/'))" WithCulture="false" Type="Non-Resx" />
        </ItemGroup>
    </Target>
</Project>
