<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <AssemblyName>using-secrets</AssemblyName>
        <RootNamespace>ArcanaGuardian</RootNamespace>
        <PackAsTool>true</PackAsTool>
        <ToolCommandName>using-secrets</ToolCommandName>
        <PackageId>ArcanaGuardian</PackageId>
        <Authors>David Lambert</Authors>
        <Description>Run a program with named secrets after a person approves the request on a web page with a passkey. The agent never sees a value.</Description>
        <PackageTags>secrets;dotenvx;passkey;webauthn;cli;agents</PackageTags>
        <PackageLicenseExpression>BSD-3-Clause</PackageLicenseExpression>
        <PackageReadmeFile>README.md</PackageReadmeFile>
    </PropertyGroup>

    <ItemGroup>
        <None Include="..\..\README.md" Pack="true" PackagePath="\"/>
        <None Include="..\..\THIRD-PARTY-NOTICES.md" Pack="true" PackagePath="\"/>
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\ArcanaGuardian.Core\ArcanaGuardian.Core.csproj"/>
        <ProjectReference Include="..\ArcanaGuardian.Bitwarden\ArcanaGuardian.Bitwarden.csproj"/>
        <ProjectReference Include="..\ArcanaGuardian.LastPass\ArcanaGuardian.LastPass.csproj"/>
        <ProjectReference Include="..\ArcanaGuardian.OnePassword\ArcanaGuardian.OnePassword.csproj"/>
        <ProjectReference Include="..\ArcanaGuardian.Vault\ArcanaGuardian.Vault.csproj"/>
    </ItemGroup>
</Project>
