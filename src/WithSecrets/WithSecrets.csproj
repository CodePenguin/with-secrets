<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
        <AssemblyName>with-secrets</AssemblyName>
        <RootNamespace>WithSecrets</RootNamespace>
        <!-- dotnet publish -c Release -r win-x64 gives one self-contained exe; no .NET runtime is needed on the box. -->
        <PublishSingleFile>true</PublishSingleFile>
        <SelfContained>true</SelfContained>
    </PropertyGroup>

    <ItemGroup>
        <ProjectReference Include="..\WithSecrets.Core\WithSecrets.Core.csproj"/>
        <ProjectReference Include="..\WithSecrets.Windows\WithSecrets.Windows.csproj"/>
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Dotenvx.Core" Version="2.38.2"/>
    </ItemGroup>
</Project>
