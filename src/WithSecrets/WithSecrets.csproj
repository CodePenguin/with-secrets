<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <AssemblyName>with-secrets</AssemblyName>
        <RootNamespace>WithSecrets</RootNamespace>
        <PackAsTool>true</PackAsTool>
        <ToolCommandName>with-secrets</ToolCommandName>
        <PackageId>WithSecrets</PackageId>
        <Authors>David Lambert</Authors>
        <Description>Run a program with named secrets after a person approves the request on a web page with a passkey. The agent never sees a value.</Description>
        <PackageTags>secrets;dotenvx;passkey;webauthn;cli;agents</PackageTags>
        <PackageLicenseExpression>BSD-3-Clause</PackageLicenseExpression>
        <PackageReadmeFile>README.md</PackageReadmeFile>
    </PropertyGroup>

    <ItemGroup>
        <None Include="..\..\README.md" Pack="true" PackagePath="\"/>
        <None Include="..\..\THIRD-PARTY-NOTICES.md" Pack="true" PackagePath="\"/>
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\WithSecrets.Core\WithSecrets.Core.csproj"/>
        <ProjectReference Include="..\WithSecrets.Bitwarden\WithSecrets.Bitwarden.csproj"/>
        <ProjectReference Include="..\WithSecrets.LastPass\WithSecrets.LastPass.csproj"/>
        <ProjectReference Include="..\WithSecrets.OnePassword\WithSecrets.OnePassword.csproj"/>
    </ItemGroup>
</Project>
